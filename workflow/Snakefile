# The project's workflow: simulate, fine-tune, publish, score and the
# paper, one Snakemake workflow. See workflow/README.md for the targets.
#
#   snakemake --workflow-profile workflow/profiles/<role> <target>
#
# or the Taskfile entry points (`task workflow:simulate`, `task workflow:finetune`, ...).
# Machine settings come from config/local.env (flowlib.localconfig),
# the rest from workflow/config.yaml.

import os
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(workflow.basedir)))

from flowlib import machine  # noqa: E402
from snakemake.utils import validate  # noqa: E402


configfile: str(Path(workflow.basedir) / "config.yaml")
# The paper's settings (paper/workflow/config.yaml), beside the workflow's.
configfile: str(Path(workflow.basedir).parent / "paper" / "workflow" / "config.yaml")


# Every setting checked against its schema: a misspelt or unknown key is
# an error before any job runs (workflow/schemas/config.schema.yaml).
validate(config, "schemas/config.schema.yaml")


include: "rules/common.smk"
include: "rules/simulate.smk"
include: "rules/finetune.smk"
include: "rules/evaluate.smk"
include: "rules/publish.smk"
include: "rules/score.smk"
include: "rules/report.smk"
include: "rules/paper.smk"
include: "rules/monitor.smk"


rule all:
    default_target: True
    # This machine's targets (TARGETS in config/local.env; by default
    # simulate, finetune and score). Releases and evidence pushes are
    # their own targets (`release`, `publish`, `land`).
    input:
        rules.simulate.input if "simulate" in TARGETS else [],
        rules.push.input if "push" in TARGETS else [],
        rules.finetune.input if "finetune" in TARGETS else [],
        rules.score.input if "score" in TARGETS else [],


onstart:
    # The fine-tuning dashboard, served with a run that fine-tunes when
    # the config says so (`dashboard.serve`); it ends with the
    # coordinator, or with this run (flowlib.dashboard.serve).
    from flowlib.dashboard import serve

    if serve.wanted(config, TARGETS):
        # A side process: never the reason a run fails.
        try:
            serve.ensure(LOCAL, serve.driver_pid())
        except Exception as e:
            say(f"dashboard not served: {e}")


onerror:
    say(f"FAILED; the failing rule and its error are in the Snakemake log {log}")
