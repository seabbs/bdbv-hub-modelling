# The walk models' scores with no pairing and with the rolling rho_p, on
# development data only (`nowcasteval.pairing`): the German development
# half, and the development seeds' outbreaks as the synthetic runner
# forecasts them. `si_copula` summarises both for the SI's copula figure.
# A dummy German benchmark leaves them out, and null development
# simulations the synthetic half and `si_copula`.
if GERMANY["real"] and FLOW.host_outputs:

    rule pairing_germany:
        input:
            TRIANGLE,
        output:
            scores=f"{R}/evidence/pairing/pairing-germany.csv.gz",
            # Each walk model's rolling rho_p by nowcast date and level.
            rho=FLOW.workflow_evidence()["copula_rho"],
        log:
            f"{R}/logs/pairing_germany.log",
        conda:
            TOOLS_ENV
        threads: FORECAST.threads
        resources:
            gpu=FORECAST.gpu,
            heavy=1,
        params:
            env=FORECAST.env,
            germany=GERMANY_CLI,
            args=f"--config {GERMANY['config']} --data {GERMANY['data']}",
            out=lambda w, output: Path(output.scores).parent,
        shell:
            "exec >{log} 2>&1; {params.env} "
            "{params.germany} pairing-sensitivity {params.args} "
            "--out {params.out}"


if GERMANY["real"] and SYNTHETIC["simulations"]["development"]:

