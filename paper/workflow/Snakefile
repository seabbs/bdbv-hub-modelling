        conda:
            TOOLS_ENV
        params:
            python=PYTHON,
            args=FLOW.extra_args(entry),
        shell:
            "exec >{log} 2>&1; "
            "{params.python} -m paperpipe germany-extra --input {input} "
            "{params.args} --out {output}"


# The synthetic runner forecasts each run's simulated outbreaks once they
# exist (`scripts/run_synthetic.py`), at `synthetic.samples` draws per forecast.
# A run with no forecasts file (`synthetic.forecasts.<mode>: null`) uses the
# dummy synthetic study, as `germany.real: false` does.
for _mode in MODES:
    # Without the simulations the forecasts file is a stored input.
    if not SYNTHETIC["forecasts"][_mode] or not SYNTHETIC["simulations"][_mode]:
        continue

    rule:
        name:
            f"synthetic_forecasts_{_mode}"
        input:
            sims=FLOW.synthetic_simulations(_mode),
            finetuned=FINETUNED,
        output:
            SYNTHETIC["forecasts"][_mode],
        log:
            f"{R}/logs/synthetic_forecasts_{_mode}.log",
        conda:
            TOOLS_ENV
        threads: FORECAST.threads
        resources:
            heavy=1,
            gpu=FORECAST.gpu,
        params:
            python=PYTHON,
            # The simulations folder, from its first file.
            sims=lambda w, input: str(Path(input.sims[0]).parent),
            seeds=FLOW.seeds(_mode),
            # The fine-tuned models run once there is a final run.
            models=FLOW.synthetic_models_arg(),
            samples=config["synthetic"]["samples"],
            device=FORECAST.device,
            threads=FORECAST.threads,
            env=FORECAST.env,
            ft=FT_EXPORT,
        shell:
            "exec >{log} 2>&1; {params.ft} {params.env} "
            "{params.python} paper/scripts/run_synthetic.py {params.sims} "
            "{output} --seeds {params.seeds} --samples {params.samples} "
            "--device {params.device} --threads {params.threads} {params.models}"


rule development:
    input:
        f"{R}/development/published",


rule paper:
    input:
        f"{R}/paper/published",


rule render:
    input:
        f"{R}/{config['render']}/published",
        "paper/main.qmd",
        "paper/si.qmd",
    output:
        "paper/main.html",
        "paper/main.pdf",
        "paper/si.html",
        "paper/si.pdf",
    log:
        f"{R}/logs/render.log",
    # Needs the network, git or quarto: runs on the driver's host.
    localrule: True
    conda:
        TOOLS_ENV
    shell:
        "exec >{log} 2>&1; cd paper && quarto render main.qmd && quarto render si.qmd"


# The German benchmark: its data and its development forecasts. Pages
# makes neither (`host_outputs: false`); its Site build fetches the data
# and stacks the stored forecasts before the paper runs.
if FLOW.host_outputs:

    rule germany_fetch:
        output:
            TRIANGLE,
        log:
            f"{R}/logs/germany_fetch.log",
        # Needs the network, git or quarto: runs on the driver's host.
        localrule: True
        conda:
            TOOLS_ENV
        params:
            germany=GERMANY_CLI,
            germany_config=GERMANY["config"],
            germany_data=lambda w, output: Path(output[0]).parent,
        shell:
            "exec >{log} 2>&1; "
            "{params.germany} fetch --config {params.germany_config} "
            "--out {params.germany_data}"

    rule germany_development:
        input:
            TRIANGLE,
            FINETUNED,
        output:
            f"{GERMANY['results']}/paper-forecasts.csv.gz",
        log:
            f"{R}/logs/germany_development.log",
        benchmark:
            f"{R}/benchmarks/germany_development/germany_development.tsv"
        conda:
            TOOLS_ENV
        threads: FORECAST.threads
        resources:
            gpu=FORECAST.gpu,
        params:
            env=FORECAST.env,
            ft=FT_EXPORT,
            germany=GERMANY_CLI,
            germany_root_config=GERMANY["config"],
            args=f"--config {GERMANY['config']} --data {GERMANY['data']}",
            out=lambda w, output: Path(output[0]).parent,
        shell:
            "exec >{log} 2>&1; {params.ft} {params.env} "
            "{params.germany} backtest {params.args} --out {params.out} && "
            "{params.germany} teams {params.args} --out {params.out} && "
            "{params.germany} paper --config {params.germany_root_config} "
            "--results {params.out}"


# Only a paper run asks for this, so development never runs it.
rule germany_heldout:
    input:
        TRIANGLE,
        FINETUNED,
    output:
        f"{GERMANY['results']}/held-out/paper-forecasts.csv.gz",
    log:
        f"{R}/logs/germany_heldout.log",
    benchmark:
        f"{R}/benchmarks/germany_heldout/germany_heldout.tsv"
    conda:
        TOOLS_ENV
    threads: FORECAST.threads
    resources:
        gpu=FORECAST.gpu,
    params:
        env=FORECAST.env,
        ft=FT_EXPORT,
        germany=GERMANY_CLI,
        germany_root_config=GERMANY["config"],
        args=f"--config {GERMANY['config']} --data {GERMANY['data']}",
        # The held-out forecasts are in the results folder's held-out/.
        out=lambda w, output: Path(output[0]).parent.parent,
    shell:
        "exec >{log} 2>&1; {params.ft} {params.env} "
        "{params.germany} backtest {params.args} --held-out "
        "--out {params.out} && "
        "{params.germany} teams {params.args} --held-out --out {params.out} && "
        "{params.germany} paper --config {params.germany_root_config} "
        "--results {params.out}/held-out"


rule ebola_hub:
    output:
        f"{EBOLA['hub']}/target-data/time-series.csv",
    log:
        f"{R}/logs/ebola_hub.log",
    # Snakemake makes the output's folders first, so clone beside them.
    # Needs the network, git or quarto: runs on the driver's host.
    localrule: True
    conda:
        TOOLS_ENV
    params:
        repo=EBOLA["hub_repo"],
        hub=lambda w, output: Path(output[0]).parent.parent,
    shell:
        "exec >{log} 2>&1; "
        "rm -rf {params.hub}.clone && "
        "git clone --quiet --depth 1 {params.repo} {params.hub}.clone && "
        "rm -rf {params.hub} && mv {params.hub}.clone {params.hub}"


if FLOW.round_releases():

    # Our models each round did not submit, from the round's release
    # (`paperpipe round-releases`); the submitted ones are the hub's copy.
    rule round_releases:
        output:
            FLOW.round_releases(),
        log:
            f"{R}/logs/round_releases.log",
        # git fetch and gh release download: runs on the driver's host.
        localrule: True
        conda:
            TOOLS_ENV
        params:
            python=PYTHON,
            repo=EBOLA["round_releases"]["repo"],
            ledger=EBOLA["round_releases"]["ledger"],
            asset=EBOLA["round_releases"]["asset"],
            tmp=f"{R}/evidence/round-releases.tmp",
        shell:
            "exec >{log} 2>&1; "
            "rm -rf {params.tmp} && mkdir -p {params.tmp} && "
            "git fetch -q origin {params.ledger} && "
            "git show FETCH_HEAD:submissions.csv > {params.tmp}/submissions.csv && "
            "tags=$(gh release list -R {params.repo} -L 1000 --json tagName "
            "--jq '.[].tagName | select(startswith(\"round-\"))') && "
            "for tag in $tags; do "
            "gh release download $tag -R {params.repo} -p {params.asset} "
            '-D {params.tmp}/$tag || echo "$tag has no {params.asset}"; '
            "done && "
            "{params.python} -m paperpipe round-releases "
            "--releases {params.tmp} --ledger {params.tmp}/submissions.csv "
            "--out {output} && rm -rf {params.tmp}"


