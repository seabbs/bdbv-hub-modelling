# The synthetic half made above, or the stored one (`stored`).
if GERMANY["real"] and FLOW.pairing_germany_file() and FLOW.pairing_synthetic_file():

    rule si_copula:
        input:
            FLOW.pairing_germany_file(),
            FLOW.pairing_synthetic_file(),
        output:
            FLOW.workflow_evidence()["si_copula"],
        log:
            f"{R}/logs/si_copula.log",
        conda:
            TOOLS_ENV
        params:
            python=PYTHON,
        shell:
            "exec >{log} 2>&1; "
            "{params.python} -m paperpipe pairing {input} --out {output}"


# The grid's training rounds against the German development half, for
# the SI's realism figure and numbers (`paperpipe realism`).
if FLOW.rounds_dir:

    rule sim_realism:
        input:
            **FLOW.realism_inputs(),
        output:
            sims=FLOW.workflow_evidence()["sim_summaries"],
            reference=FLOW.workflow_evidence()["sim_realism"],
        log:
            f"{R}/logs/sim_realism.log",
        conda:
            TOOLS_ENV
        params:
            python=PYTHON,
        shell:
            "exec >{log} 2>&1; "
            "{params.python} -m paperpipe realism {input.rounds} "
            "--germany {input.germany} --out-sims {output.sims} "
            "--out-reference {output.reference}"


# The grid tables and SI notes, read from the grid config
# (`papertables.synthetic_grid`).
rule grid_tables:
    input:
        grid=SYNTHETIC["grid_file"],
        release=lambda w: [final_release_layer()] if final_release_layer() else [],
    output:
        grid=f"{R}/{{mode}}/tables/si/grid.md",
        model=f"{R}/{{mode}}/tables/si/epinowcast-model.md",
        heldout=f"{R}/{{mode}}/tables/si/heldout-set.md",
    log:
        f"{R}/{{mode}}/logs/grid_tables.log",
    conda:
        TOOLS_ENV
    params:
        python=PYTHON,
        config=shlex.quote(json.dumps(FLOW.grid_config())),
        si=f"{R}/{{mode}}/tables/si",
        grid_name=lambda w, input: input.grid,
        release=lambda w, input: (
            f"--release-layer {input.release[0]}" if input.release else ""
        ),
    shell:
        "exec >{log} 2>&1; "
        "{params.python} -m papertables.synthetic_grid --grid {input.grid} "
        "--grid-name {params.grid_name} "
        "--config {params.config} --si-dir {params.si} "
        "{params.release}"


rule evidence:
    input:
        **{n: FLOW.evidence_file(n) for n in EVIDENCE if n in EVIDENCE_NAMES},
        # The validation loss curve, the published-range rows, the realism
        # step's outputs and the pairing scores, from workflow rules.
        **FLOW.workflow_evidence(),
    output:
        yml=f"{R}/{{mode}}/evidence.yml",
    log:
        f"{R}/{{mode}}/logs/evidence.log",
    conda:
        TOOLS_ENV
    params:
        python=PYTHON,
        args=FLOW.evidence_args(EVIDENCE_NAMES),
        workflow=FLOW.options(FLOW.workflow_evidence()),
        si=f"{R}/{{mode}}/tables/si",
        fig=f"{R}/{{mode}}/figures/si",
        # The live fine-tuning run, whose newest scored checkpoints are
        # shown as preliminary.
        live=FLOW.live_arg(),
        comparisons=FLOW.comparisons_arg(),
    shell:
        "exec >{log} 2>&1; "
        "{params.python} -m paperpipe evidence {params.args} --mode {wildcards.mode} "
        "{params.workflow} "
        "--si-dir {params.si} --fig-dir {params.fig} --out {output.yml} "
        "{params.live} {params.comparisons}"


rule summary:
    input:
        meta=FLOW.summary_meta,
        scores=FLOW.summary_scores,
        # The checkpoint the `_ft` models loaded, which the summary names.
        finetuned=FINETUNED,
    output:
        f"{R}/{{mode}}/results.yml",
    log:
        f"{R}/{{mode}}/logs/summary.log",
    conda:
        TOOLS_ENV
    params:
        python=PYTHON,
        args=FLOW.summary_args(),
    shell:
        "exec >{log} 2>&1; "
        "{params.python} -m paperpipe summary --mode {wildcards.mode} "
        "--meta {input.meta} --scores {input.scores} --out {output} "
        "{params.args}"


# The host-made development outputs the Site build reads, each set
# released once per contents as paper-<set>-<hash> (`paperpipe.stored`):
# the synthetic forecasts and pairing scores, the final run's validation
# curve and the runs' checkpoint tables, and the simulation summaries and
# example seeds. Each set's rule exists on a host that makes its inputs.
# `promote_paper_<set>` then names that release the set's current one in
# the release paper-<set>-main, which the Site build reads, from a commit
# on `promote_branches` only. Writes releases, so it is the opt-in target
# `paper_inputs`.
STORED_SETS = {
    name: files
    for name, files in stored.sets(
        {**FLOW.config, "evidence": FLOW.evidence}, R
    ).items()
    if {
        "synthetic": SYNTHETIC["simulations"]["development"],
        "finetune": config.get("final_run"),
        "simulations": FLOW.rounds_dir,
        "germany": GERMANY["real"] and FLOW.host_outputs,
    }[name]
}


for _set, _files in STORED_SETS.items():

    rule:
        name:
            f"release_paper_{_set}"
        input:
            list(_files.values()),
        output:
            f"{R}/released/{_set}.json",
        log:
            f"{R}/logs/release_paper_{_set}.log",
        # gh: runs on the driver's host.
        localrule: True
        conda:
            TOOLS_ENV
        params:
            python=PYTHON,
            files=" ".join(
                shlex.quote(f"{name}={path}") for name, path in _files.items()
            ),
            heldout=shlex.quote(json.dumps(config["heldout"])),
        shell:
            "exec >{log} 2>&1; "
            f"{{params.python}} -m paperpipe.stored publish {_set} "
            "--heldout {params.heldout} --record {output} "
            "--file {params.files}"

    rule:
        name:
            f"promote_paper_{_set}"
        input:
            f"{R}/released/{_set}.json",
        output:
            f"{R}/promoted/{_set}.json",
        log:
            f"{R}/logs/promote_paper_{_set}.log",
        # gh and git: runs on the driver's host.
        localrule: True
        conda:
            TOOLS_ENV
        params:
            python=PYTHON,
            branches=PROMOTE_BRANCHES,
        shell:
            "exec >{log} 2>&1; "
            "{params.python} -m paperpipe.stored promote --released {input} "
            "--record {output} --branches {params.branches}"


rule paper_inputs:
    input:
        [f"{R}/promoted/{name}.json" for name in STORED_SETS],


# The paper reads `build`, so it shows the last run published.
rule publish_paper:
    input:
        outputs=FLOW.outputs,
        summary=rules.summary.output,
    output:
        # Outside `build`, which each publish replaces.
        touch(f"{R}/{{mode}}/published"),
    log:
        f"{R}/{{mode}}/logs/publish.log",
    # Needs the network, git or quarto: runs on the driver's host.
    localrule: True
    conda:
        TOOLS_ENV
    params:
        run=lambda w: f"{R}/{w.mode}",
        build=BUILD,
        # The tables the paper includes from studies a development run
        # leaves out: placeholders, inside sections it does not show.
        held=FLOW.held_out_placeholders,
    shell:
        "exec >{log} 2>&1; "
        "rm -rf {params.build} && mkdir -p {params.build} && "
        "cp -R {params.run}/figures {params.run}/tables {params.build}/ && "
        "cp {input.summary} {params.build}/results.yml && "
        "cp {params.run}/evidence.yml {params.build}/evidence.yml && "
        "for f in {params.held}; do mkdir -p $(dirname $f) && "
        "echo '*Held out until the paper run.*' > $f; done"
