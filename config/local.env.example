# Machine settings for the fine-tuning and simulation scripts
# (workflow/flowlib/localconfig.py). Copy to config/local.env, which git ignores,
# and set what differs on this machine. Leave a line out to take its
# default; with no file everything runs on this machine. A variable set
# in the environment wins over this file. A value may use another
# setting ($ROOT) in any order.

# The host holding the rounds, as ssh names it. Empty: this machine.
REMOTE=
# The rounds' ROOT on REMOTE (relative to its home). Default: ROOT.
#REMOTE_ROOT=

# On the machine that simulates (workflow/rules/simulate.smk): its rounds
# folder and mailbox. Default: $HOME/bdbv-rounds and $HOME/bdbv-mailbox.md.
#ROOT=$HOME/bdbv-rounds
#MAILBOX=$HOME/bdbv-mailbox.md

# This machine's name in mailbox lines and manifests. Default: hostname -s.
#HOST_NAME=

# Memory (GB) a job leaves free when it starts.
#MIN_FREE_GB=20
# The folder simulation batches share their JAX compiles in, and the size
# in GB past which a batch empties it (empty JAX_CACHE: no cache).
#JAX_CACHE=$ROOT/jax-cache
#JAX_CACHE_GB=2
#MIN_DISK_GB=16
# Load average below which a heavy job starts (empty: the core count).
#MAX_LOAD=

# Machines sharing the rounds (`task nowcast-foundation:simulate` on the
# rounds host, `task nowcast-foundation:push` on a helper): the seeds this
# machine takes (seeds, first-last ranges or rounds as r<N>; empty: all),
# and the prefix every job runs under (a machine without memory cgroups,
# such as macOS, caps each job with "workflow/scripts/mem_cap.sh {mem}").
#SIM_SEEDS=
#JOB_PREFIX=

# The workflow's budget (workflow/profiles/default, flowlib.machine):
# this machine's cores and memory less what is kept free for its user,
# or set outright; simulation batches at once.
#HEADROOM_CORES=0
#HEADROOM_GB=0
#CORES=
#MEM_MB=
#SIM_SLOTS=2
# The prefix every simulation batch runs under. Batches have no memory
# cap of their own: one shared guard, such as a systemd slice holding
# what the trainer and the machine's user do not need (create it with
# MemoryMax set first), kills a rare runaway batch, which is retried.
#SIM_PREFIX="systemd-run --user --scope -q --slice=bdbv-sims.slice"
# The device the trainer and checkpoint scoring run torch on: auto
# (CUDA, then MPS, then CPU), cuda, mps or cpu.
#DEVICE=auto
# Series above which a training step recomputes activations in backward
# (empty: finetune.checkpoint_above in workflow/config.yaml); a machine
# with less GPU memory sets it lower. Memory only: the steps and the hash
# stay.
#CHECKPOINT_ABOVE=
# Series in one Chronos-2 forward pass (Chronos-2's default, 256).
#CHRONOS_BATCH=256
# German dates a checkpoint scoring unit forecasts together, their
# Chronos-2 quantiles held at once (more is faster, and uses more memory).
#SCORE_DATES=20
# The precision Chronos-2 forecasts and scores in (training stays fp32):
# fp32, fp16, bf16 or auto (fp16 on CUDA before Ampere, bf16 on Ampere and
# later and on Apple GPUs, fp32 on the CPU).
#PRECISION=auto
# The device and CPU threads of held-out evaluation and checkpoint
# scoring, which run beside the trainer; the GPU is the trainer's.
#EVAL_DEVICE=cpu
#EVAL_THREADS=2
# PyTorch's MPS memory watermark, on Apple GPUs.
#MPS_HIGH_WATERMARK=0.85
# Hugging Face cache of the base model.
#HF_HOME=output/finetune/hf

# Fine-tuning (`task nowcast-foundation:finetune`; the runs are in
# workflow/config.yaml, each in $ROOT/runs/<run>): where batches
# come from (local: this machine's rounds; remote: the rounds host's,
# REMOTE and REMOTE_ROOT above, each batch once its round's manifest
# lists it; release: the sims-r<N> releases); and any value to release
# each checkpoint as it is saved.
#SIMS_FROM=
#PUBLISH=

# Where jobs run (workflow/flowlib/compute.py): single (this machine),
# or ssh (this machine coordinates the run and places each job on a
# worker, name=host:ROOT:CHECKOUT, host `local` for this machine; rule
# groups simulate, train, evaluate, publish and score go to the worker
# named, the rest to the first with room); and the command running
# Snakemake in a worker's checkout. ssh copies job files with rsync:
# the coordinator needs GNU rsync >= 3.1 first on PATH (on macOS,
# Homebrew's; /usr/bin/rsync is openrsync and cannot).
#COMPUTE=single
#WORKERS=
#WORKER_GROUPS=
#WORKER_SNAKEMAKE="uv run --group paper snakemake"

# Scheduled runs (`task nowcast-workflow:run`, one tick after another): this
# machine's targets, the pool ones (simulate, push, finetune, score,
# dashboard) as one Snakemake run on its budget, then land, publish and
# release; the pause between ticks and after a failed one (seconds);
# and mailbox lines (any value).
#SCHEDULE_TARGETS=
#COORDINATE_PAUSE=60
#COORDINATE_BACKOFF=600
#NOTIFY=

# How often each tick writes this machine's run status (seconds).
#STATUS_EVERY=60
# The workflow monitor: the Panoptes server every Snakemake run reports
# to (empty: off; another machine's address to report there), and where
# `task nowcast-workflow:monitor` serves it.
#MONITOR_URL=http://$MONITOR_HOST:$MONITOR_PORT
#MONITOR_HOST=127.0.0.1
#MONITOR_PORT=8795
# The targets whose rule graph and job DAG the monitor draws at /dag/,
# NAME=TARGET, coloured by each job's state; the Snakemake options they
# are built with (for example a run's --configfile); and every how many
# seconds they are built again.
#MONITOR_DAG=
#MONITOR_DAG_OPTIONS=
#MONITOR_DAG_EVERY=900
