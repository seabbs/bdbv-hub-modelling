# Machine settings for the fine-tuning and simulation scripts
# (workflow/flowlib/localconfig.py). Copy to config/local.env, which git ignores,
# and set what differs on this machine. Leave a line out to take its
# default; with no file everything runs on this machine. A variable set
# in the environment wins over this file. A value may use another
# setting ($ROOT) in any order.

# The host holding the rounds, as ssh names it. Empty: this machine.
REMOTE=
# The rounds' ROOT on REMOTE (relative to its home). Default: ROOT.
#REMOTE_ROOT=

# On the machine that simulates (workflow/rules/simulate.smk): its rounds
# folder and mailbox. Default: $HOME/bdbv-rounds and $HOME/bdbv-mailbox.md.
#ROOT=$HOME/bdbv-rounds
#MAILBOX=$HOME/bdbv-mailbox.md
# Where the dashboard (task workflow:dashboard) listens: an
# address of this machine (127.0.0.1 keeps it local; a tailnet address
# serves the tailnet) and a port. Default: 127.0.0.1 and 8765.
#DASHBOARD_HOST=127.0.0.1
#DASHBOARD_PORT=8765
# The ROOT whose runs the dashboard shows (default: ROOT).
#DASHBOARD_ROOT=

# This machine's name in mailbox lines and manifests. Default: hostname -s.
#HOST_NAME=

# Memory and disk (GB) a tick needs free to start.
#MIN_FREE_GB=20
# The folder simulation batches share their JAX compiles in, and the size
# in GB past which a batch empties it (empty JAX_CACHE: no cache).
#JAX_CACHE=$ROOT/jax-cache
#JAX_CACHE_GB=2
#MIN_DISK_GB=16

# Machines sharing the rounds (`task workflow:simulate` on the
# rounds host, `task workflow:push` on a helper): the seeds this
# machine takes (seeds, first-last ranges or rounds as r<N>; empty: all).
#SIM_SEEDS=

# The workflow's budget (workflow/profiles/default, flowlib.machine):
# this machine's cores and memory less what is kept free for its user,
# or set outright; simulation batches at once. Batches run one thread
# each and claim 5.5 GB, so SIM_SLOTS is best the cores left after the
# headroom and the trainer's (`finetune.cut_workers` + 1): on archie,
# 16 - 4 - 4 = 8. Eight batches simulate a round about twice as fast as
# four.
#HEADROOM_CORES=0
#HEADROOM_GB=0
#CORES=
#MEM_MB=
#SIM_SLOTS=2
# The cores kept for a trainer, for each GPU (each trains a run at
# once): jobs beside them share the rest
# (`side_cores`), so a trainer whose inputs appear mid-run never waits
# behind them. Its threads, `finetune.cut_workers` + 1; 0 where nothing
# trains, so every core goes to the other jobs. Its memory is kept the
# same way (`side_mem_mb`), from its own benchmarks; 0 keeps none.
#TRAINER_CORES=4
# A Snakemake profile of this machine's own, kept outside the repository,
# which replaces the one COMPUTE gives (start from a copy of
# workflow/profiles/default or workflow/profiles/slurm).
#SNAKEMAKE_PROFILE=
# The device the trainer runs torch on: auto (CUDA, then MPS, then CPU),
# cuda, mps or cpu. Forecasting jobs use FORECAST_DEVICE below.
#DEVICE=auto
# The CUDA GPUs the workflow shares out, comma-separated ids (empty:
# those CUDA_VISIBLE_DEVICES names, else every one nvidia-smi lists).
# The `gpu` resource has a slot for each, and each GPU job (the trainer,
# and forecasting jobs on cuda) runs on a
# GPU of its own (workflow/flowlib/gpus.py).
#GPUS=
# Series above which a training step recomputes activations in backward
# (empty: finetune.checkpoint_above in workflow/config.yaml); a machine
# with less GPU memory sets it lower. Memory only: the steps and the hash
# stay.
#CHECKPOINT_ABOVE=
# Series in one Chronos-2 forward pass (Chronos-2's default, 256).
#CHRONOS_BATCH=256
# German dates a checkpoint scoring unit forecasts together, their
# Chronos-2 quantiles held at once (more is faster, and uses more memory).
#SCORE_DATES=20
# Worker processes a German scoring unit splits its dates over, one
# thread and one chunk of dates' memory each (empty: score.workers in
# workflow/config.yaml, 2). The held-out evaluation leaves a unit's
# workers free, so more workers take threads from it. A unit on CUDA
# forecasts in one process.
#SCORE_WORKERS=4
# The precision Chronos-2 forecasts and scores in (training stays fp32):
# fp32, fp16, bf16 or auto (fp16 on CUDA before Ampere, bf16 on Ampere and
# later and on Apple GPUs, fp32 on the CPU).
#PRECISION=auto
# This machine's device (cpu, cuda or mps) and CPU threads for every
# forecasting job: held-out evaluation, backtests and the paper's runs.
# The held-out evaluation takes the device; the German units take
# score.device in workflow/config.yaml (the CPU) and SCORE_WORKERS.
# Empty: `forecast` in workflow/config.yaml (the CPU, 2 threads). A CUDA
# job takes a whole GPU, so it waits for a free one.
#FORECAST_DEVICE=cpu
#FORECAST_THREADS=2
# PyTorch's MPS memory watermark, on Apple GPUs.
#MPS_HIGH_WATERMARK=0.85
# Hugging Face cache of the base model.
#HF_HOME=output/finetune/hf

# Fine-tuning (`task workflow:finetune`; the runs are in
# workflow/config.yaml, each in $ROOT/runs/<run>): where batches
# come from (local: this machine's rounds; remote: the rounds host's,
# REMOTE and REMOTE_ROOT above, each batch once its round's manifest
# lists it; release: the sims-r<N> releases); and any value to release
# each checkpoint as it is saved.
#SIMS_FROM=
#PUBLISH=

# Where jobs run (workflow/flowlib/compute.py): single (this machine), slurm
# (every job a Slurm job, below),
# or ssh (this machine coordinates the run and places each job on a
# worker, name=host:ROOT:CHECKOUT, host `local` for this machine; rule
# groups simulate, train, evaluate, publish and score go to the worker
# named, the rest to the first with room); and the command running
# Snakemake in a worker's checkout. ssh copies job files with rsync:
# the coordinator needs GNU rsync >= 3.1 first on PATH (on macOS,
# Homebrew's; /usr/bin/rsync is openrsync and cannot).
#COMPUTE=single
# COMPUTE=slurm (workflow/README.md, Run on a Slurm cluster): the
# account jobs are charged to (empty: the plugin's guess) and the
# site's partitions file, a copy of
# workflow/profiles/slurm/partitions.example.yaml (empty: sinfo's
# default partition for every job).
#SLURM_ACCOUNT=
#SLURM_PARTITIONS=
#WORKERS=
#WORKER_GROUPS=
#WORKER_SNAKEMAKE="uv run --group paper snakemake"

# Scheduled runs (`task workflow:run`, one tick after another): this
# machine's targets, the pool ones (simulate, push, finetune, score) as
# one Snakemake run on its budget, then land, publish and release; the pause between ticks and after a failed one (seconds);
# and mailbox lines (any value).
#SCHEDULE_TARGETS=
#COORDINATE_PAUSE=60
#COORDINATE_BACKOFF=600
#NOTIFY=

# How often each tick writes this machine's run status (seconds).
#STATUS_EVERY=60
# The workflow monitor: the Panoptes server every Snakemake run reports
# to (empty: off; another machine's address to report there), and where
# `task workflow:monitor` serves it.
#MONITOR_URL=http://$MONITOR_HOST:$MONITOR_PORT
#MONITOR_HOST=127.0.0.1
#MONITOR_PORT=8795
# The targets whose rule graph and job DAG the monitor draws at /dag/,
# NAME=TARGET, coloured by each job's state; the Snakemake options they
# are built with (for example a run's --configfile); and every how many
# seconds they are built again.
#MONITOR_DAG=
#MONITOR_DAG_OPTIONS=
#MONITOR_DAG_EVERY=900
